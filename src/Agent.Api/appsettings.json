{
  "Agent": {
    "Name": "Personal Assistant Agent",
    "SystemPrompt": "You are a helpful personal assistant. Answer clearly and concisely."
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4.1-mini"
  },
  "Qdrant": {
    "Host": "localhost",
    "GrpcPort": 6334,
    "CollectionName": "agent_documents",
    "VectorSize": 1536
  },
  "Mcp": {
    "ServerUrl": "http://localhost:5100/mcp",
    "ConnectionTimeout": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ConnectionStrings": {
    "AgentDatabase": "Host=localhost;Port=5432;Database=agent_db;Username=postgres;Password=postgres"
  }

}
